# Editor defaults (https://editorconfig.org). rustfmt.toml is authoritative for Rust formatting;
# this file keeps every other text file consistent with it.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 100

[*.{yml,yaml,json}]
indent_size = 2
